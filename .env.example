# ============================================================
# REVIO CRM — Variables de entorno (producción)
# Copie este archivo a `.env` en el servidor o `.env.local` en desarrollo.
# Documentación completa: DEPLOYMENT.md
# ============================================================

# ── OBLIGATORIAS ─────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Clave service-role. Solo servidor; nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AES-256-GCM — 64 caracteres hex (32 bytes).
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret (App Settings → Basic). Verifica webhook WhatsApp.
META_APP_SECRET=your-meta-app-secret

# ── RECOMENDADAS (producción) ────────────────────────────────

# URL canónica pública (sin barra final)
NEXT_PUBLIC_SITE_URL=https://crm.example.com

# Locale BCP-47 (Colombia: es-CO)
NEXT_PUBLIC_APP_LOCALE=es-CO

# Wompi — pagos B2B licencias REVIO (COP)
WOMPI_ENV=production
NEXT_PUBLIC_WOMPI_ENV=production
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_prod_your_public_key
WOMPI_INTEGRITY_SECRET=prod_integrity_your_integrity_secret

# ── RUNTIME DOCKER / NODE ────────────────────────────────────

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# ── OPCIONALES ───────────────────────────────────────────────

# Hostnames permitidos en URLs de invitación (CSV, sin esquema)
# ALLOWED_INVITE_HOSTS=crm.example.com,crm-staging.example.com

# Bearer secret para GET /api/automations/cron y /api/flows/cron
# Generar: openssl rand -hex 32
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# Meta App ID — requerido para plantillas con encabezado IMAGE
# META_APP_ID=your-meta-app-id

# Solo dev/CI — omite Meta al enviar plantillas
# WHATSAPP_TEMPLATES_DRY_RUN=true

# Asistente IA (BYOK — claves por cuenta en Settings)
# AI_REQUEST_TIMEOUT_MS=30000
# AI_CONTEXT_MESSAGE_LIMIT=20

# ── SANDBOX Wompi (desarrollo local) ─────────────────────────
# Sustituya las variables WOMPI_* de arriba por:
# WOMPI_ENV=sandbox
# NEXT_PUBLIC_WOMPI_ENV=sandbox
# NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_your_sandbox_public_key
# WOMPI_INTEGRITY_SECRET=test_integrity_your_sandbox_integrity_secret
# Tarjetas: 4242…4242 (APPROVED), 4111…1111 (DECLINED)
